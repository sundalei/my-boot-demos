[Unit]
Description=entra-id-backend (port 9091, loopback)
After=network.target

[Service]
Type=simple
User=appsvc
Group=appsvc
WorkingDirectory=/opt/gateway-demo
# Force loopback so nothing outside the box can hit the backend directly and
# forge identity headers.
Environment=SERVER_ADDRESS=127.0.0.1
# Override the module's default 9090: on Rocky, Cockpit (the web console) already
# listens on 9090. Keep in sync with the route uri in application-prod.yml.
Environment=SERVER_PORT=9091
ExecStart=/usr/bin/java -jar /opt/gateway-demo/backend.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
