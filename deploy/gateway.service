[Unit]
Description=entra-gateway-demo (Spring Cloud Gateway) on 443
After=network.target backend.service
Wants=backend.service

[Service]
Type=simple
User=appsvc
Group=appsvc
WorkingDirectory=/opt/gateway-demo
EnvironmentFile=/etc/gateway-demo/gateway.env
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/usr/bin/java -jar /opt/gateway-demo/gateway.jar

# Let a NON-root user bind privileged port 443 — same mechanism Maverics uses.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
