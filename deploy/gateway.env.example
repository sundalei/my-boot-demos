# Copy to /etc/gateway-demo/gateway.env and fill in real values, then:
#   sudo chmod 600 /etc/gateway-demo/gateway.env
#   sudo chown appsvc:appsvc /etc/gateway-demo/gateway.env
#
# Read by gateway.service (EnvironmentFile) and the cert deploy hook.

# --- Entra app registration for app.sundalei.tech ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-client-secret-value

# --- TLS keystore the gateway serves on 443 ---
GATEWAY_TLS_KEYSTORE=/opt/gateway-demo/app.p12
GATEWAY_TLS_PASSWORD=changeit
